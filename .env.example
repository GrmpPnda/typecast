# Copy to .env (repository root for Docker, or backend/.env to run directly).
# Only the keys below are recognised; an unknown key makes the backend refuse to
# start rather than silently ignoring it.

# Where the database and uploads/ live. The Docker image sets this to /app/data,
# which is the mounted volume. Leave unset to use backend/.
# TYPECAST_DATA_DIR=

# Setting this explicitly overrides TYPECAST_DATA_DIR for the database only.
# For Postgres, paste the connection string from your provider: the driver and
# libpq-style sslmode are corrected automatically, so
# "postgresql://user:pass@host:5432/typecast?sslmode=require" becomes
# "postgresql+asyncpg://...?ssl=require". Requires the [postgres] extra.
# Backups are database-neutral, so an archive from a SQLite install imports
# into a Postgres one and the other way round.
# Typecast creates its tables on startup but not the database itself.
# DATABASE_URL=postgresql://user:pass@host:5432/typecast?sslmode=require

# Migrate the schema to the latest revision on startup. Leave on for a single
# replica; set to 0 and run "alembic upgrade head" separately if several
# replicas start at once, since they would race to apply the same revision.
# TYPECAST_AUTO_MIGRATE=1

# --- Authentication -------------------------------------------------------
# local (default) auto-logs in a single user, which is correct on your own
# machine and an open door on anything reachable. Use multi for a deployment.
# TYPECAST_AUTH_MODE=multi

# proxy: single sign-on through an authenticating proxy (Azure Easy Auth or
# oauth2-proxy). Verify the identity token it forwards (recommended):
# TYPECAST_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# TYPECAST_OIDC_AUDIENCE=<application (client) id>
# ...or, only if no request can reach the app except through the proxy:
# TYPECAST_PROXY_TRUST_HEADERS=1
# TYPECAST_PROXY_PRESET=easyauth   (or oauth2-proxy)

# On an empty database these create the first administrator, who then creates
# every other account from Settings. Ignored once any user exists, so they
# cannot reset a password or resurrect a deleted account.
# TYPECAST_ADMIN_EMAIL=you@example.com
# TYPECAST_ADMIN_PASSWORD=
# TYPECAST_ADMIN_USERNAME=admin
# TYPECAST_ADMIN_NAME=Administrator

# Self-service signup. Off by default: on a reachable deployment it lets anyone
# who finds the URL create an account.
# TYPECAST_OPEN_REGISTRATION=0

# --- TLS ------------------------------------------------------------------
# Redirect http to https and send HSTS. Only for deployment behind a
# TLS-terminating proxy, and only with uvicorn --proxy-headers (which both
# Dockerfiles pass); without it every request looks like http and redirects loop.
# TYPECAST_FORCE_HTTPS=1

# The docker-compose stack terminates TLS in nginx. On first start it generates
# a self-signed certificate for this name (localhost and 127.0.0.1 are always
# included); mount real tls.crt and tls.key at /etc/nginx/certs instead to use
# your own. See README > Certificates.
# TYPECAST_TLS_HOSTNAME=typecast.example.com
# TYPECAST_HTTPS_PORT=443
# TYPECAST_HTTP_PORT=80

# Restrict which origins may call the API. Defaults to "*", which is fine for a
# local single-user server and too broad for a deployment.
# TYPECAST_CORS_ORIGINS=https://typecast.example.com

EXPORT_PROFILES_DIR=./profiles
AI_PROVIDER=anthropic
AI_API_KEY=
SECRET_KEY=change-me-in-production
